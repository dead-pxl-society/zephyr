{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main", "share"],
	"permissions": [
		"core:default",
		"opener:default",
		"opener:allow-open-path",
		"os:default",
		"dialog:default",
		"fs:allow-exists",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$HOME/**" },
				{ "path": "$DOWNLOAD/**" },
				{ "path": "$DOCUMENT/**" },
				{ "path": "$DESKTOP/**" },
				{ "path": "$PICTURE/**" },
				{ "path": "$VIDEO/**" },
				{ "path": "$AUDIO/**" }
			]
		}
	]
}
